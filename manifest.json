{
  "manifest_version": 3,
  "name": "Video Speed Controller",
  "version": "2.0.0",
  "description": "Simple 1x/16x playback speed controller for HTML5 media.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}